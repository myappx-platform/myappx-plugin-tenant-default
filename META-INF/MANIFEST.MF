Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: MyAppx Plugin : Tenant Default
Bundle-SymbolicName: org.idempiere.myappx.plugin.tenant.default;singleton:=true
Bundle-Version: 14.0.0.qualifier
Bundle-Vendor: Ken Longnan <ken.longnan@gmail.com>
Bundle-RequiredExecutionEnvironment: JavaSE-17
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version>=17))"
Require-Bundle: org.adempiere.base;bundle-version="0.0.0",
 org.adempiere.base.process;bundle-version="0.0.0",
 org.adempiere.plugin.utils;bundle-version="0.0.0",
 org.adempiere.ui.zk;bundle-version="0.0.0",
 org.idempiere.zk.extra;bundle-version="0.0.0",
 org.osgi.service.event,
 zcommon;bundle-version="0.0.0",
 zel;bundle-version="0.0.0",
 zk;bundle-version="0.0.0",
 zul;bundle-version="0.0.0",
 zhtml;bundle-version="0.0.0",
 org.idempiere.myappx.plugin.odt;bundle-version="0.0.0"
Import-Package: org.osgi.framework;version="1.6.0",
 org.osgi.service.event;version="1.3.0"
Bundle-ClassPath: .
Service-Component: OSGI-INF/*.xml
Bundle-ActivationPolicy: lazy
Bundle-Activator: org.idempiere.myappx.plugin.tenant.x.Activator
Automatic-Module-Name: org.idempiere.myappx.plugin.tenant.default
